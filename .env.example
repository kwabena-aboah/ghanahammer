# GhanaHammer — Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ─── Core Django ──────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-50-chars-long
# Local PC defaults. Use the production values shown below on Namecheap.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=auction_platform.settings.development
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL (Render provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/ghanahammer

# SQLite for local dev (override in development.py)
# DATABASE_URL=sqlite:///db.sqlite3

# ─── Redis (Celery + Channels) ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Email ────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@ghanahammer.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=GhanaHammer <noreply@ghanahammer.com>

# For dev: use console backend
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ─── Paystack ────────────────────────────────────────────────
# Get from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# Register this webhook URL in the Paystack dashboard for asynchronous payment confirmations:
# https://machineauction.vercel.app/payments/webhook/paystack/
# Enable Paystack Transfers and disable transfer OTP approval for automated payouts.

# Generate a random secret and set it in Vercel for scheduled escrow payouts.
CRON_SECRET=generate-a-long-random-secret

# Test keys (for development)
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ─── Meta WhatsApp Business API ──────────────────────────────
# Get from https://developers.facebook.com/
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# ─── Cloudflare API and R2 (Media Storage for Production) ─────
# API token is for Cloudflare API calls; R2 uses S3-compatible credentials.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=ghanahammer-media
# Optional custom domain connected to the public R2 bucket.
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# ─── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://ghanahammer.com,https://www.ghanahammer.com
